# Server Configuration
PORT=5000
NODE_ENV=development
# Note: Render tự động set NODE_ENV=production, không cần thêm vào .env trên Render

# Database (Render sẽ cung cấp DATABASE_URL)
DATABASE_URL=postgresql://username:password@localhost:5432/dgtech

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment (SePay)
SEPAY_API_TOKEN=your_sepay_token
SEPAY_ACCOUNT_NUMBER=your_account_number
SEPAY_ACCOUNT_NAME=your_account_name
SEPAY_BANK_CODE=your_bank_code
